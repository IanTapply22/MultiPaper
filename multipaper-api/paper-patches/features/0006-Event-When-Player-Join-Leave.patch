From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: IanTapply22 <iantapply22@gmail.com>
Date: Thu, 5 Mar 2026 18:05:49 -0500
Subject: [PATCH] Event When Player Join Leave


diff --git a/src/main/java/com/iantapply/multipaper/event/player/PlayerJoinExternalServerEvent.java b/src/main/java/com/iantapply/multipaper/event/player/PlayerJoinExternalServerEvent.java
new file mode 100644
index 0000000000000000000000000000000000000000..0a7b2da7f7906a3086f684fb65c8e70382284161
--- /dev/null
+++ b/src/main/java/com/iantapply/multipaper/event/player/PlayerJoinExternalServerEvent.java
@@ -0,0 +1,58 @@
+package com.iantapply.multipaper.event.player;
+
+import org.bukkit.event.Event;
+import org.bukkit.event.HandlerList;
+import org.jetbrains.annotations.NotNull;
+
+import java.util.UUID;
+
+/**
+ * Called when a player joins an external MultiPaper instance.
+ */
+public class PlayerJoinExternalServerEvent extends Event {
+
+    private static final HandlerList handlers = new HandlerList();
+    private final UUID playerUniqueId;
+    private final String playerName;
+    private final String localServerName;
+
+    public PlayerJoinExternalServerEvent(UUID playerUniqueId, String playerName, String localeServerName) {
+        super(false);
+        this.playerUniqueId = playerUniqueId;
+        this.playerName = playerName;
+        this.localServerName = localeServerName;
+    }
+
+    /**
+     * Returns the name of this player
+     */
+    public String getPlayerName() {
+        return this.playerName;
+    }
+
+    /**
+     * Returns a unique and persistent id for this entity
+     */
+    public UUID getPlayerUniqueId() {
+        return this.playerUniqueId;
+    }
+
+    /**
+     * Get the bungeecord name of this server.
+     *
+     * @return the bungeecord name of this server
+     */
+    public String getLocalServerName() {
+        return this.localServerName;
+    }
+
+    @Override
+    public @NotNull HandlerList getHandlers() {
+        return handlers;
+    }
+
+    @NotNull
+    public static HandlerList getHandlerList() {
+        return handlers;
+    }
+}
diff --git a/src/main/java/com/iantapply/multipaper/event/player/PlayerLeaveExternalServerEvent.java b/src/main/java/com/iantapply/multipaper/event/player/PlayerLeaveExternalServerEvent.java
